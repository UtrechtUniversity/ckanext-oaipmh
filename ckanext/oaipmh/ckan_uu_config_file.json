{
    "ckan_aaa_titles_single2": {
        "type": "single",
        "select_base": "titles>title"
	},
    "ckan_publisher_single": {
		"type": "single",
		"select_base": "publisher"
	},
    "ckan_identifier_single": {
		"type": "single",
		"select_base": "identifier"
	},
    "ckan_identifier_single_set": {
		"type": "single",
		"select_base": "identifier",
		"set_definition": {
            "ckan_title_name": "#text",
            "ckan_title_language": "@identifierType"
        }
	},
    "ckan_resource_type": {
		"type": "single",
		"select_base": "resourceType",
		"set_definition": {
            "ckan_resource": "#text",
            "ckan_resource_type": "@resourceTypeGeneral"
        }
	},	
    "ckan_publication_year_single": {
		"type": "single",
		"select_base": "publicationYear"
	},
    "ckan_publication_year_fixed": {
		"type": "fixed",
		"select_base": "2050"
	},
	"ckan_formats_array": {
        "type": "array",
        "select_base": "formats>format"
    },
	"ckan_formats2_array": {
        "type": "array",
        "select_base": "formats2>format2"
    },
    "ckan_titles_set": {
        "type": "array",
        "select_base": "titles>title",
        "set_definition": {
            "ckan_title_name": "#text",
            "ckan_title_language": "@xml:lang"
        }
	},
    "ckan_subjects_set": {
        "type": "array",
        "select_base": "subjects>subject",
        "set_definition": {
            "ckan_title_name": "#text",
            "ckan_title_language": "@subjectScheme"
        }
	},
    "ckan_creator_set": {
        "type": "array",
        "select_base": "creators>creator",
        "set_definition": {
            "ckan_surname": "familyName",
            "ckan_firstname": "givenName",
			"ckan_creatorname": "creatorName#text",
			"ckan_creatorname_type": "creatorName@nameType",
			"ckan_nameIdentifier_ORCID": "nameIdentifier[@nameIdentifierScheme=ORCID]#text"
        }
	},
	"ckan_related_identifier_set": {
        "type": "array",
        "select_base": "relatedIdentifiers>relatedIdentifier",
        "set_definition": {
            "ckan_rel_idf": "#text",
			"ckan_rel_idf_type": "@relatedIdentifierType"
        }
	}
}